# docker-compose.yml 用。コピーして `.env` を作成し、値を入れること。
# `.env` はコミットしない（.gitignore対象）。
STUDIO_DB_NAME=nexus_studio
STUDIO_DB_USER=studio
STUDIO_DB_PASSWORD=

# apps/studio-api を `dotnet run` する場合、上記と一致する接続文字列を渡す。
# 既定値はコード・appsettings.jsonのどこにも置いていない（Step 0-d）。
# ConnectionStrings__StudioDatabase=Host=localhost;Port=5433;Database=nexus_studio;Username=studio;Password=<STUDIO_DB_PASSWORDと同じ値>
