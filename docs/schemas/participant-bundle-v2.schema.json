{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/m0o9l0v3/NexusMobile/develop/docs/schemas/participant-bundle-v2.schema.json",
  "title": "Nexus participant bundle schema v2",
  "description": "E2-5 §5 の参加者向け bundle（schema_version 2.0.0、2.1.0）。Studio が射影する payload の形を検査する。2.1.0 は E2-5 改訂1 で categories・occurrences・events を任意項目として加えた。§5.3 の不変条件のうち配列をまたぐ参照整合は Schema では表せないため、Studio の射影と iOS の受信時の検査で確かめる。",
  "type": "object",
  "required": ["nexus_bundle", "spots", "id_aliases", "map"],
  "properties": {
    "nexus_bundle": { "$ref": "#/$defs/bundleMetadata" },
    "spots": {
      "type": "array",
      "items": { "$ref": "#/$defs/spot" }
    },
    "id_aliases": {
      "type": "array",
      "items": { "$ref": "#/$defs/idAlias" }
    },
    "map": {
      "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/map" }]
    },
    "categories": {
      "description": "E2-5 改訂1（2.1.0）。公開中のカテゴリ一覧。配列の順序が表示順。",
      "type": "array",
      "items": { "$ref": "#/$defs/category" }
    },
    "occurrences": {
      "description": "E2-5 改訂1（2.1.0）。公開中の開催回。最も早い開催日の順（同じなら id の順）。",
      "type": "array",
      "items": { "$ref": "#/$defs/occurrence" }
    },
    "events": {
      "description": "E2-5 改訂1（2.1.0）。公開中のイベント（取り下げたものは含めない）。id の順。",
      "type": "array",
      "items": { "$ref": "#/$defs/event" }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "bundleMetadata": {
      "type": "object",
      "required": ["schema_version", "bundle_version", "release_id", "published_at"],
      "properties": {
        "schema_version": { "enum": ["2.0.0", "2.1.0"] },
        "bundle_version": { "type": "integer", "minimum": 1 },
        "release_id": {
          "type": "string",
          "pattern": "^[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{12}$"
        },
        "published_at": {
          "type": "string",
          "description": "RFC 3339 の UTC 日時（オフセットは Z または +00:00）。月・日・時・分・秒の範囲を検査する。月ごとの日数（2月30日など）は Schema では検査しない。",
          "pattern": "^[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])[Tt](?:[01][0-9]|2[0-3]):[0-5][0-9]:(?:[0-5][0-9]|60)(?:\\.[0-9]+)?(?:[Zz]|\\+00:00)$"
        }
      },
      "additionalProperties": false
    },
    "canonicalId": {
      "description": "E1-3 規則1：ASCII 小文字の lower_snake_case。Studio の canonical_id 列に合わせて128文字まで。",
      "type": "string",
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$"
    },
    "aliasId": {
      "description": "旧ID（E1-3 の alias）。正規形に従わない旧資料の ID もありうるため字句形式は課さない。Studio の alias 列に合わせて200文字まで。",
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "description": {
      "description": "E2-5 §5.2：未作成は null とし、空文字で埋めない。最大長は契約で定めていない。",
      "oneOf": [{ "type": "null" }, { "type": "string", "minLength": 1 }]
    },
    "spot": {
      "type": "object",
      "required": ["id", "name", "kind", "description", "search_aliases", "utilization", "placement"],
      "properties": {
        "id": { "$ref": "#/$defs/canonicalId" },
        "name": { "$ref": "map-dataset-geojson-v2.schema.json#/$defs/displayName" },
        "kind": {
          "enum": [null, "classroom", "facility", "service"]
        },
        "description": { "$ref": "#/$defs/description" },
        "search_aliases": {
          "type": "array",
          "items": { "$ref": "map-dataset-geojson-v2.schema.json#/$defs/displayName" }
        },
        "utilization": {
          "enum": ["available", "noNewSelection"]
        },
        "placement": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/buildingPlacement" },
            { "$ref": "#/$defs/formalEntrancePlacement" },
            { "$ref": "#/$defs/roomPlacement" },
            { "$ref": "#/$defs/landmarkPlacement" }
          ]
        }
      },
      "additionalProperties": false
    },
    "buildingPlacement": {
      "type": "object",
      "required": ["feature_type", "building_id", "floor_id", "point", "access_node_id"],
      "properties": {
        "feature_type": { "const": "building" },
        "building_id": { "$ref": "map-dataset-geojson-v2.schema.json#/$defs/buildingId" },
        "floor_id": { "type": "null" },
        "point": { "type": "null" },
        "access_node_id": {
          "oneOf": [{ "type": "null" }, { "$ref": "map-dataset-geojson-v2.schema.json#/$defs/indoorNodeId" }]
        }
      },
      "additionalProperties": false
    },
    "formalEntrancePlacement": {
      "type": "object",
      "required": ["feature_type", "building_id", "floor_id", "point", "access_node_id"],
      "properties": {
        "feature_type": { "const": "formal_entrance" },
        "building_id": { "$ref": "map-dataset-geojson-v2.schema.json#/$defs/buildingId" },
        "floor_id": { "$ref": "map-dataset-geojson-v2.schema.json#/$defs/floorId" },
        "point": { "$ref": "map-dataset-geojson-v2.schema.json#/$defs/position" },
        "access_node_id": { "type": "null" }
      },
      "additionalProperties": false
    },
    "roomPlacement": {
      "type": "object",
      "required": ["feature_type", "building_id", "floor_id", "point", "access_node_id"],
      "properties": {
        "feature_type": { "const": "room" },
        "building_id": { "$ref": "map-dataset-geojson-v2.schema.json#/$defs/buildingId" },
        "floor_id": { "$ref": "map-dataset-geojson-v2.schema.json#/$defs/floorId" },
        "point": { "$ref": "map-dataset-geojson-v2.schema.json#/$defs/position" },
        "access_node_id": {
          "oneOf": [{ "type": "null" }, { "$ref": "map-dataset-geojson-v2.schema.json#/$defs/indoorNodeId" }]
        }
      },
      "additionalProperties": false
    },
    "landmarkPlacement": {
      "type": "object",
      "required": ["feature_type", "building_id", "floor_id", "point", "access_node_id"],
      "properties": {
        "feature_type": { "const": "landmark" },
        "building_id": { "type": "null" },
        "floor_id": { "type": "null" },
        "point": { "$ref": "map-dataset-geojson-v2.schema.json#/$defs/position" },
        "access_node_id": {
          "oneOf": [{ "type": "null" }, { "$ref": "map-dataset-geojson-v2.schema.json#/$defs/outdoorNodeId" }]
        }
      },
      "additionalProperties": false
    },
    "idAlias": {
      "type": "object",
      "required": ["alias", "canonical_id"],
      "properties": {
        "alias": { "$ref": "#/$defs/aliasId" },
        "canonical_id": { "$ref": "#/$defs/canonicalId" }
      },
      "additionalProperties": false
    },
    "uuid": {
      "type": "string",
      "pattern": "^[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{12}$"
    },
    "localDate": {
      "description": "キャンパス現地（JST）の日付 YYYY-MM-DD。",
      "type": "string",
      "pattern": "^[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])$"
    },
    "localTime": {
      "description": "キャンパス現地（JST）の時刻 HH:mm。",
      "type": "string",
      "pattern": "^(?:[01][0-9]|2[0-3]):[0-5][0-9]$"
    },
    "note": {
      "description": "任意の補足・中止案内。無いときは null とし、空文字で埋めない。",
      "oneOf": [{ "type": "null" }, { "type": "string", "minLength": 1 }]
    },
    "status": {
      "description": "normal（通常）／cancelled（中止）。開催日が中止なら、その日の枠はすべて中止として扱う。",
      "enum": ["normal", "cancelled"]
    },
    "category": {
      "type": "object",
      "required": ["id", "name"],
      "properties": {
        "id": { "$ref": "#/$defs/uuid" },
        "name": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "occurrence": {
      "type": "object",
      "required": ["id", "name", "days"],
      "properties": {
        "id": { "$ref": "#/$defs/uuid" },
        "name": { "type": "string", "minLength": 1 },
        "days": {
          "description": "配列の順序が表示順。",
          "type": "array",
          "items": { "$ref": "#/$defs/occurrenceDay" }
        }
      },
      "additionalProperties": false
    },
    "occurrenceDay": {
      "type": "object",
      "required": ["id", "date", "public_start", "public_end", "status", "cancel_note"],
      "properties": {
        "id": { "$ref": "#/$defs/uuid" },
        "date": { "$ref": "#/$defs/localDate" },
        "public_start": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/localTime" }] },
        "public_end": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/localTime" }] },
        "status": { "$ref": "#/$defs/status" },
        "cancel_note": { "$ref": "#/$defs/note" }
      },
      "additionalProperties": false
    },
    "event": {
      "type": "object",
      "required": ["id", "title", "description", "category_id", "occurrence_id", "slots"],
      "properties": {
        "id": { "$ref": "#/$defs/uuid" },
        "title": { "type": "string", "minLength": 1 },
        "description": { "$ref": "#/$defs/description" },
        "category_id": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/uuid" }] },
        "occurrence_id": { "$ref": "#/$defs/uuid" },
        "slots": {
          "description": "配列の順序が表示順。",
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/slot" }
        }
      },
      "additionalProperties": false
    },
    "slot": {
      "type": "object",
      "required": ["id", "day_id", "date", "time_mode", "start", "end", "participation", "status", "cancel_note", "venues"],
      "properties": {
        "id": { "$ref": "#/$defs/uuid" },
        "day_id": { "$ref": "#/$defs/uuid" },
        "date": { "$ref": "#/$defs/localDate" },
        "time_mode": {
          "description": "fixed（時間を指定）／allDay（終日）。終日の start・end は、射影時に開催日の public_start・public_end を入れる（S4-3）。",
          "enum": ["fixed", "allDay"]
        },
        "start": { "$ref": "#/$defs/localTime" },
        "end": { "$ref": "#/$defs/localTime" },
        "participation": {
          "description": "atStart（開始時刻に参加）／anytime（時間内は随時参加）。",
          "enum": ["atStart", "anytime"]
        },
        "status": { "$ref": "#/$defs/status" },
        "cancel_note": { "$ref": "#/$defs/note" },
        "venues": {
          "description": "配列の順序が表示順。",
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/venue" }
        }
      },
      "additionalProperties": false
    },
    "venue": {
      "type": "object",
      "required": ["spot_id", "note"],
      "properties": {
        "spot_id": { "$ref": "#/$defs/canonicalId" },
        "note": { "$ref": "#/$defs/note" }
      },
      "additionalProperties": false
    },
    "map": {
      "type": "object",
      "required": ["dataset_version", "dataset_sha256", "geojson"],
      "properties": {
        "dataset_version": { "type": "integer", "minimum": 1 },
        "dataset_sha256": { "type": "string", "pattern": "^[0-9A-Fa-f]{64}$" },
        "geojson": { "$ref": "map-dataset-geojson-v2.schema.json" }
      },
      "additionalProperties": false
    }
  }
}
