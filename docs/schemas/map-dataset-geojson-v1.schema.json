{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gitlab.com/11h27m/nexus-mobile/-/raw/develop/docs/schemas/map-dataset-geojson-v1.schema.json",
  "title": "Nexus MapDataset GeoJSON schema v1",
  "type": "object",
  "required": ["type", "nexus", "features"],
  "properties": {
    "type": { "const": "FeatureCollection" },
    "nexus": { "$ref": "#/$defs/nexusMetadata" },
    "features": {
      "type": "array",
      "items": {
        "oneOf": [
          { "$ref": "#/$defs/buildingFeature" },
          { "$ref": "#/$defs/formalEntranceFeature" },
          { "$ref": "#/$defs/outdoorWalkingPathFeature" },
          { "$ref": "#/$defs/indoorWalkingPathFeature" },
          { "$ref": "#/$defs/indoorNodeFeature" },
          { "$ref": "#/$defs/outdoorNodeFeature" }
        ]
      }
    },
    "bbox": { "$ref": "#/$defs/bbox" }
  },
  "additionalProperties": false,
  "$defs": {
    "nexusMetadata": {
      "type": "object",
      "required": ["schema_version", "floors"],
      "properties": {
        "schema_version": { "const": "1.0.0" },
        "floors": {
          "type": "array",
          "items": { "$ref": "#/$defs/floor" }
        }
      },
      "additionalProperties": false
    },
    "floor": {
      "type": "object",
      "required": ["id", "building_id"],
      "properties": {
        "id": { "$ref": "#/$defs/floorId" },
        "building_id": { "$ref": "#/$defs/buildingId" },
        "name": { "$ref": "#/$defs/displayName" }
      },
      "additionalProperties": false
    },
    "displayName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "buildingId": {
      "enum": [
        "ab",
        "amh",
        "aptr",
        "ar",
        "ctc_main",
        "ctc2",
        "dh",
        "dvh",
        "hgr_a",
        "hgr_b",
        "lbh",
        "mb",
        "ptb",
        "sab"
      ]
    },
    "floorId": {
      "type": "string",
      "pattern": "^(?:ab|amh|aptr|ar|ctc_main|ctc2|dh|dvh|hgr_a|hgr_b|lbh|mb|ptb|sab)_(?:[1-9][0-9]*|b[1-9][0-9]*)f$"
    },
    "indoorNodeId": {
      "type": "string",
      "pattern": "^(?:ab|amh|aptr|ar|ctc_main|ctc2|dh|dvh|hgr_a|hgr_b|lbh|mb|ptb|sab)_(?:[1-9][0-9]*|b[1-9][0-9]*)f_n_(?:00[1-9]|0[1-9][0-9]|[1-9][0-9]{2})$"
    },
    "outdoorNodeId": {
      "type": "string",
      "pattern": "^campus_n_(?:00[1-9]|0[1-9][0-9]|[1-9][0-9]{2})$"
    },
    "entranceId": {
      "type": "string",
      "pattern": "^(?:ab|amh|aptr|ar|ctc_main|ctc2|dh|dvh|hgr_a|hgr_b|lbh|mb|ptb|sab)_ent_(?:00[1-9]|0[1-9][0-9]|[1-9][0-9]{2})$"
    },
    "indoorEdgeId": {
      "type": "string",
      "pattern": "^(?:ab|amh|aptr|ar|ctc_main|ctc2|dh|dvh|hgr_a|hgr_b|lbh|mb|ptb|sab)_(?:[1-9][0-9]*|b[1-9][0-9]*)f_e_(?:00[1-9]|0[1-9][0-9]|[1-9][0-9]{2})$"
    },
    "outdoorEdgeId": {
      "type": "string",
      "pattern": "^campus_e_(?:00[1-9]|0[1-9][0-9]|[1-9][0-9]{2})$"
    },
    "position": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "prefixItems": [
        { "type": "number", "minimum": -180, "maximum": 180 },
        { "type": "number", "minimum": -90, "maximum": 90 }
      ],
      "items": false
    },
    "bbox": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "prefixItems": [
        { "type": "number", "minimum": -180, "maximum": 180 },
        { "type": "number", "minimum": -90, "maximum": 90 },
        { "type": "number", "minimum": -180, "maximum": 180 },
        { "type": "number", "minimum": -90, "maximum": 90 }
      ],
      "items": false
    },
    "pointGeometry": {
      "type": "object",
      "required": ["type", "coordinates"],
      "properties": {
        "type": { "const": "Point" },
        "coordinates": { "$ref": "#/$defs/position" },
        "bbox": { "$ref": "#/$defs/bbox" }
      },
      "additionalProperties": false
    },
    "lineStringGeometry": {
      "type": "object",
      "required": ["type", "coordinates"],
      "properties": {
        "type": { "const": "LineString" },
        "coordinates": {
          "type": "array",
          "minItems": 2,
          "items": { "$ref": "#/$defs/position" }
        },
        "bbox": { "$ref": "#/$defs/bbox" }
      },
      "additionalProperties": false
    },
    "linearRing": {
      "type": "array",
      "minItems": 4,
      "items": { "$ref": "#/$defs/position" }
    },
    "polygonGeometry": {
      "type": "object",
      "required": ["type", "coordinates"],
      "properties": {
        "type": { "const": "Polygon" },
        "coordinates": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/linearRing" }
        },
        "bbox": { "$ref": "#/$defs/bbox" }
      },
      "additionalProperties": false
    },
    "buildingFeature": {
      "type": "object",
      "required": ["type", "id", "geometry", "properties"],
      "properties": {
        "type": { "const": "Feature" },
        "id": { "$ref": "#/$defs/buildingId" },
        "geometry": { "$ref": "#/$defs/polygonGeometry" },
        "properties": {
          "type": "object",
          "required": ["feature_type"],
          "properties": {
            "feature_type": { "const": "building" },
            "name": { "$ref": "#/$defs/displayName" }
          },
          "additionalProperties": false
        },
        "bbox": { "$ref": "#/$defs/bbox" }
      },
      "additionalProperties": false
    },
    "formalEntranceFeature": {
      "type": "object",
      "required": ["type", "id", "geometry", "properties"],
      "properties": {
        "type": { "const": "Feature" },
        "id": { "$ref": "#/$defs/entranceId" },
        "geometry": { "$ref": "#/$defs/pointGeometry" },
        "properties": {
          "type": "object",
          "required": [
            "feature_type",
            "building_id",
            "floor_id",
            "outside_node_id",
            "inside_node_id",
            "is_primary",
            "accessibility"
          ],
          "properties": {
            "feature_type": { "const": "formal_entrance" },
            "building_id": { "$ref": "#/$defs/buildingId" },
            "floor_id": { "$ref": "#/$defs/floorId" },
            "outside_node_id": { "$ref": "#/$defs/outdoorNodeId" },
            "inside_node_id": { "$ref": "#/$defs/indoorNodeId" },
            "is_primary": { "type": "boolean" },
            "accessibility": { "$ref": "#/$defs/accessibility" },
            "name": { "$ref": "#/$defs/displayName" },
            "opening_hours": { "$ref": "#/$defs/displayName" }
          },
          "additionalProperties": false
        },
        "bbox": { "$ref": "#/$defs/bbox" }
      },
      "additionalProperties": false
    },
    "accessibility": {
      "enum": ["accessible", "not_accessible", "unknown"]
    },
    "pathKind": {
      "enum": ["walkway", "corridor", "ramp", "stairs"]
    },
    "outdoorWalkingPathFeature": {
      "type": "object",
      "required": ["type", "id", "geometry", "properties"],
      "properties": {
        "type": { "const": "Feature" },
        "id": { "$ref": "#/$defs/outdoorEdgeId" },
        "geometry": { "$ref": "#/$defs/lineStringGeometry" },
        "properties": {
          "type": "object",
          "required": [
            "feature_type",
            "scope",
            "from_node_id",
            "to_node_id",
            "path_kind",
            "bidirectional",
            "accessibility",
            "distance_m",
            "estimated_seconds"
          ],
          "properties": {
            "feature_type": { "const": "walking_path" },
            "scope": { "const": "campus" },
            "from_node_id": { "$ref": "#/$defs/outdoorNodeId" },
            "to_node_id": { "$ref": "#/$defs/outdoorNodeId" },
            "path_kind": { "$ref": "#/$defs/pathKind" },
            "bidirectional": { "type": "boolean" },
            "accessibility": { "$ref": "#/$defs/accessibility" },
            "distance_m": { "type": "number", "exclusiveMinimum": 0 },
            "estimated_seconds": { "type": "number", "exclusiveMinimum": 0 }
          },
          "additionalProperties": false
        },
        "bbox": { "$ref": "#/$defs/bbox" }
      },
      "additionalProperties": false
    },
    "indoorWalkingPathFeature": {
      "type": "object",
      "required": ["type", "id", "geometry", "properties"],
      "properties": {
        "type": { "const": "Feature" },
        "id": { "$ref": "#/$defs/indoorEdgeId" },
        "geometry": { "$ref": "#/$defs/lineStringGeometry" },
        "properties": {
          "type": "object",
          "required": [
            "feature_type",
            "scope",
            "building_id",
            "floor_id",
            "from_node_id",
            "to_node_id",
            "path_kind",
            "bidirectional",
            "accessibility",
            "distance_m",
            "estimated_seconds"
          ],
          "properties": {
            "feature_type": { "const": "walking_path" },
            "scope": { "const": "indoor" },
            "building_id": { "$ref": "#/$defs/buildingId" },
            "floor_id": { "$ref": "#/$defs/floorId" },
            "from_node_id": { "$ref": "#/$defs/indoorNodeId" },
            "to_node_id": { "$ref": "#/$defs/indoorNodeId" },
            "path_kind": { "$ref": "#/$defs/pathKind" },
            "bidirectional": { "type": "boolean" },
            "accessibility": { "$ref": "#/$defs/accessibility" },
            "distance_m": { "type": "number", "exclusiveMinimum": 0 },
            "estimated_seconds": { "type": "number", "exclusiveMinimum": 0 }
          },
          "additionalProperties": false
        },
        "bbox": { "$ref": "#/$defs/bbox" }
      },
      "additionalProperties": false
    },
    "indoorNodeFeature": {
      "type": "object",
      "required": ["type", "id", "geometry", "properties"],
      "properties": {
        "type": { "const": "Feature" },
        "id": { "$ref": "#/$defs/indoorNodeId" },
        "geometry": { "$ref": "#/$defs/pointGeometry" },
        "properties": {
          "type": "object",
          "required": ["feature_type", "building_id", "floor_id", "node_kind"],
          "properties": {
            "feature_type": { "const": "indoor_node" },
            "building_id": { "$ref": "#/$defs/buildingId" },
            "floor_id": { "$ref": "#/$defs/floorId" },
            "node_kind": {
              "enum": ["junction", "destination", "transition"]
            },
            "name": { "$ref": "#/$defs/displayName" }
          },
          "additionalProperties": false
        },
        "bbox": { "$ref": "#/$defs/bbox" }
      },
      "additionalProperties": false
    },
    "outdoorNodeFeature": {
      "type": "object",
      "required": ["type", "id", "geometry", "properties"],
      "properties": {
        "type": { "const": "Feature" },
        "id": { "$ref": "#/$defs/outdoorNodeId" },
        "geometry": { "$ref": "#/$defs/pointGeometry" },
        "properties": {
          "type": "object",
          "required": ["feature_type", "scope", "node_kind"],
          "properties": {
            "feature_type": { "const": "outdoor_node" },
            "scope": { "const": "campus" },
            "node_kind": {
              "enum": ["junction", "destination", "entrance_approach"]
            },
            "name": { "$ref": "#/$defs/displayName" }
          },
          "additionalProperties": false
        },
        "bbox": { "$ref": "#/$defs/bbox" }
      },
      "additionalProperties": false
    }
  }
}
